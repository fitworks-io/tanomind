{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manymind",
  "account_id": "a31da5cbfb860762b271b9ef7c68c7e1",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-24",
  "workers_dev": true,
  "routes": [
    {
      "pattern": "tanomind.com/*",
      "zone_name": "tanomind.com"
    },
    {
      "pattern": "www.tanomind.com/*",
      "zone_name": "tanomind.com"
    }
  ],
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/t/*", "/mcp", "/oauth/*", "/.well-known/*", "/sitemap.xml"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tanomind-db",
      "database_id": "0d0374b2-8487-4424-814c-cdacaf2a5a5f",
      "migrations_dir": "migrations"
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "GAME_WORLD", "class_name": "GameWorldAuthority" }
    ]
  },
  "migrations": [
    { "tag": "v1-game-world", "new_sqlite_classes": ["GameWorldAuthority"] }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 0 * * *"]
  }
}
