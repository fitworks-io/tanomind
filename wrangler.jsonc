{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "manymind",
  "account_id": "ab9fd4b76071d1be5f1f2317c3c6d1d5",
  "main": "worker/index.ts",
  "compatibility_date": "2026-08-24",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/t/*", "/mcp", "/oauth/*", "/.well-known/*", "/sitemap.xml"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "manymind-db",
      "database_id": "5d442064-3f47-432e-9fb8-83f1a6a845c5",
      "migrations_dir": "migrations"
    }
  ],
  "observability": {
    "enabled": true
  },
  "triggers": {
    "crons": ["0 0 * * *"]
  }
}
